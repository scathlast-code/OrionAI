# Усі налаштування ботів. Скопіюйте цей файл як .env і заповніть потрібне.
# Порожні рядки можна лишити: що не заповнено — те вимкнено.

# ===== Спільне =====
# Ваш ID: у Telegram бот покаже його командою /id, у WhatsApp — це ваш номер без «+» (380501234567),
# в Instagram — бот напише ваш ID у відповідь на перше повідомлення. Кілька — через кому (запасний акаунт).
ALLOWED_USERS=123456789
# Безкоштовний домен сервера (docs/03-server.md), без https://
DOMAIN=mybots.duckdns.org
# Адреси ботів з HTTPS, без / в кінці. Так налаштовано Caddyfile: /ai — ШІ-бот, /hub — головний бот
PUBLIC_URL=https://mybots.duckdns.org/ai
MANAGER_PUBLIC_URL=https://mybots.duckdns.org/hub
BOT_TZ=Europe/Kyiv

# ===== ШІ-бот у Telegram =====
# Токен від @BotFather (docs/01-telegram.md)
TELEGRAM_TOKEN=123456789:AAAA...
# Довгий випадковий рядок (32+ символи) — секретна частина адрес конектора й команд. Нікому не показуйте
MCP_SECRET=zminit-na-dovgyi-vypadkovyi-ryadok-32-symvoly

# ===== 🧭 Головний бот =====
# 🧭 Головний бот тепер усередині Оріона — окремий токен не потрібен (лише для окремого запуску manager.py)
MANAGER_TOKEN=
# Довгий випадковий рядок (32+ символи): секретна частина адреси «скриньки» і ключ шифрування токенів у базі.
# НЕ змінюйте після запуску — інакше збережені токени ботів доведеться ввести знову
MANAGER_SECRET=insyi-dovgyi-vypadkovyi-ryadok-32-symvoly
# Як часто перевіряти ботів (секунди) і скільки «мовчання» вважати падінням
MONITOR_EVERY=300
HEARTBEAT_TIMEOUT=900
# Захист від зациклень: скільки разів одне повідомлення можна передати далі; скільки подій від бота за хвилину
RELAY_MAX_HOPS=3
RELAY_RATE_PER_MIN=30

# ===== Зв'язок ШІ-бота з головним ботом =====
# Беруться з картки ШІ-бота в головному боті: «🤖 Боти» → бот → «🔌 Підключення»
HUB_URL=
HUB_KEY=

# ===== Текстові моделі: заповніть ті, якими хочете користуватись (мінімум одну) =====
# Google Gemini — aistudio.google.com → Get API key
GEMINI_API_KEY=
# Groq — console.groq.com → API Keys
GROQ_API_KEY=
# Mistral — console.mistral.ai → API Keys (безкоштовний план Experiment)
MISTRAL_API_KEY=
# NVIDIA — build.nvidia.com → Get API Key (ключ починається з nvapi-)
NVIDIA_API_KEY=
# Ollama Cloud — ollama.com → Settings → Keys
OLLAMA_CLOUD_API_KEY=
# OpenRouter — openrouter.ai → Keys (безкоштовні моделі з позначкою :free; також музика Lyria)
OPENROUTER_API_KEY=
# Cloudflare Workers AI — токен з правом Workers AI і Account ID (також картинки FLUX)
CF_API_TOKEN=
CF_ACCOUNT_ID=
# Cohere — dashboard.cohere.com → API Keys (пробний ключ)
COHERE_API_KEY=
# Посилання на код у «🔗 Посилання» (можна задати й у боті): власник/назва
# GITHUB_REPO=

# Ваша власна Ollama (комп'ютер або сервер), наприклад http://192.168.1.10:11434
# На сервері Oracle поруч із ботами: розкоментуйте два рядки нижче й виконайте docker compose up -d --build
# COMPOSE_PROFILES=ollama
# OLLAMA_URL=http://ollama:11434
OLLAMA_URL=
# OLLAMA_KEEP_ALIVE=-1        # скільки тримати модель у пам'яті: -1 — завжди, 30m — 30 хв після останнього запиту
# OLLAMA_TIMEOUT=300          # скільки бот чекає відповіді своєї моделі, с

# ===== Вебпошук (Tavily: безкоштовний ліміт) =====
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# ===== Генератори (усе безкоштовне) =====
# Pollinations працює без ключа; токен з auth.pollinations.ai прибирає обмеження швидкості
POLLINATIONS_TOKEN=
# Порядок генераторів картинок
IMAGE_ORDER=pollinations,cloudflare,canva
# Музика через OpenRouter (експериментально, 1 — увімкнено)
OPENROUTER_MUSIC=1
# Власний музичний сервер (music_server.py на вашому комп'ютері), наприклад http://192.168.1.10:8800
MUSIC_LOCAL_URL=

# ===== Canva (потрібна інтеграція в canva.com/developers) =====
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# ===== WhatsApp (docs/01-whatsapp.md) =====
# Хто може писати ботам у WhatsApp: ваш номер без «+», через кому
WA_ALLOWED_USERS=380501234567
# Постійний токен системного користувача і Phone number ID номера ШІ-бота
WA_TOKEN=
WA_PHONE_ID=
# Phone number ID номера головного бота (другий номер). Токен — той самий, якщо обидва номери в одному акаунті
WA_HUB_PHONE_ID=
WA_HUB_TOKEN=
# Будь-яке слово — його ж впишете в кабінеті Meta під час підключення вебхука
WA_VERIFY_TOKEN=
# App Secret застосунку Meta (перевірка, що вебхук справді від Meta)
META_APP_SECRET=
# Безкоштовно — 1000 повідомлень від бота на місяць на номер (з 1.10.2026). Бот зупиняється на цьому числі, щоб не платити.
# 0 — не зупинятися (тоді Meta виставить рахунок за кожне повідомлення понад 1000)
WA_MONTHLY_STOP=990
# Необов'язково й платно: назва затвердженого шаблону, щоб бот міг нагадати поза вікном 24 год
WA_REENGAGE_TEMPLATE=

# ===== Instagram (docs/01-instagram.md) =====
# Ваш ID в Instagram (бот напише його у відповідь на перше повідомлення), через кому
IG_ALLOWED_USERS=
# ШІ-бот: токен Instagram API with Instagram Login (живе 60 днів — міст сам продовжує його раз на ~20 днів)
IG_TOKEN=
IG_VERIFY_TOKEN=
# Instagram App Secret застосунку ШІ-бота
IG_APP_SECRET=
# Головний бот: другий професійний акаунт у своєму застосунку Meta
IG_HUB_TOKEN=
IG_HUB_APP_SECRET=
IG_HUB_VERIFY_TOKEN=

# ===== Пошта для Evernote й інших сервісів, що приймають листи (docs/06-servisy.md) =====
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, пароль застосунку з myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ===== Резервні копії (docs/04-kopii.md) =====
# Скільки копій тримати в кожній хмарі. Розклад автокопій задається в боті: ⚙️ Налаштування → 💾 Копії
BACKUP_KEEP=10
# Пароль шифрування копій. Задайте — і копію без пароля ніхто не прочитає. ЗАПИШІТЬ ЙОГО окремо: без нього копію не відновити
BACKUP_PASSWORD=
# Google Диск: console.cloud.google.com → OAuth client (Web), адреси повернення <PUBLIC_URL>/backup/gdrive/callback і <MANAGER_PUBLIC_URL>/backup/gdrive/callback
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
# Dropbox: dropbox.com/developers → App folder
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# OneDrive: portal.azure.com → App registrations (особисті акаунти Microsoft)
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# ===== Необов'язково =====
# Змінити модель сервісу: <СЕРВІС>_MODEL, наприклад GEMINI_MODEL=gemini-2.5-pro
# Відомий денний ліміт для оцінки залишку: <СЕРВІС>_LIMIT_DAY, наприклад GEMINI_LIMIT_DAY=250
FALLBACK_ORDER=gemini,groq,mistral,nvidia,ollama_cloud,openrouter,cloudflare,cohere,ollama_local
HISTORY_LIMIT=30
TRASH_DAYS=30
BOT_TZ=Europe/Kyiv
# Голос: розшифровка — Groq Whisper (GROQ_API_KEY) або Cloudflare; озвучення — edge-tts (VOICE_TTS=edge, або off)
VOICE_TTS=edge

# 🏆 Пріоритети: скільки запитів до ШІ одночасно (решта — у черзі; важливіші ставлять менш важливі на паузу, не відхиляючи)
LLM_PARALLEL=2
# Скільки секунд головний бот чекає відповіді, поки ШІ-бот зайнятий (далі — «у черзі», відповідь прийде окремо)
HUB_REPLY_WAIT=25

# Railway Serverless: 1 — Telegram надсилає повідомлення вебхуком, і бот може засинати між розмовами (docs/20-railway.md)
TG_WEBHOOK=

# ⏰ Будильник для режиму «Сон + будильник»: ключ API з cron-job.org (Settings → API)
CRONJOB_API_KEY=
# 🛰 Резервні сервери (docs/21-rezervni-servery.md): порядок = пріоритет
CLUSTER_NODES=
CLUSTER_NAME=
CLUSTER_KEY=
# 🛰 Резервні сервери головного бота (окремо від ШІ-бота)
MANAGER_CLUSTER_NODES=
MANAGER_CLUSTER_NAME=
MANAGER_CLUSTER_KEY=
# Резервні сервери: копія через N с після роботи бота; «сон» після N с тиші; контрольна перевірка під час сну (0 — ні)
CLUSTER_SYNC=300
CLUSTER_IDLE=540
CLUSTER_WATCH=3600
# Тип сервера для «🤖 Автоматично»: free (Oracle, домашній ПК) або paid (Railway). Порожньо — бот визначить сам
SERVER_COST=

# Optional search providers. Some offer trial/free quotas; check current terms.
# Without keys OrionAI attempts DuckDuckGo HTML, Wikipedia, GDELT.
SERPER_API_KEY=
SERPAPI_API_KEY=
EXA_API_KEY=
YOU_API_KEY=
SEARCHAPI_API_KEY=

# Security (do not commit actual values)
SECURITY_ALLOWED_USERS=
SECURITY_DENIED_USERS=
SECURITY_GEOIP_DB=/data/GeoLite2-Country.mmdb
SECURITY_WEB_FAIL_CLOSED=1
SECURITY_TRUSTED_PROXIES=
SECURITY_REQUIRE_VERIFIED_COUNTRY=0

# ===== 🔌 Плагіни =====
# 📰 Ньюзрум — WhatsApp Business Cloud API (необов'язково; docs/17-plugins.md)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ALLOWED_SENDERS=
WHATSAPP_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
# 🧷 Стікери (необов'язково)
STICKER_MAX_PACKS=30
STICKER_PART_MB=45
STICKER_PARALLEL=6
# 📰 Ньюзрум — службовий акаунт Telegram для підписок і закритих чатів (docs/17-plugins.md)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
NEWSROOM_READ_PRIVATE=
# 📰 Ньюзрум — 🌐 соцмережі (усе необовʼязково; docs/17-plugins.md → 🌐 Соцмережі)
X_BEARER_TOKEN=
THREADS_TOKEN=
THREADS_USERNAME=
META_TOKEN=
IG_USER_ID=
IG_USERNAME=
FB_PAGE_TOKENS=
TUMBLR_API_KEY=
# власний RSSHub (запасний шлях для чужих акаунтів), напр. http://rsshub:1200
RSSHUB_URL=
RSSHUB_KEY=

# ---------------------------------------------------------------- Після об'єднання версій
# «🧭 Мої боти» вбудовано в ШІ-бот (плагін hub). Якщо головний бот у вас працює ОКРЕМО (python manager.py),
# вимкніть вбудований, щоб не було двох різних списків ботів:
# ORION_PLUGINS_OFF=hub
# Ліміт дій за хвилину для сторонніх користувачів (власника й ALLOWED_USERS не стосується):
# SECURITY_RATE_LIMIT=40
# Усі допоміжні бази лежать поруч з основною (там, де DB_PATH). Інша тека — лише якщо справді треба:
# ORION_DATA_DIR=/data
